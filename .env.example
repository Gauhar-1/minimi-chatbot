# LLM Provider Configuration ('groq' | 'google' | 'openai')
LLM_PROVIDER=groq

# Optional Custom Model Name (overrides provider default)
# Default for Groq: llama-3.3-70b-versatile (or llama-3.1-70b-versatile, llama-3.1-8b-instant)
# Default for Google: gemini-2.0-flash (or gemini-1.5-pro, gemini-1.5-flash)
# Default for OpenAI: gpt-4o (or gpt-4o-mini, o3-mini)
LLM_MODEL=llama-3.3-70b-versatile

# Provider API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=AIza_your_google_ai_key_here
OPENAI_API_KEY=sk_your_openai_key_here

# Tavily Search API Key (Required for live web search and deep scraping)
TAVILY_API_KEY=tvly_your_tavily_key_here
